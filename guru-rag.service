[Unit]
Description=Guru RAG API Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/guru_rag
ExecStart=/home/ubuntu/guru_rag/venv/bin/python3 main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PATH=/home/ubuntu/guru_rag/venv/bin
Environment=PYTHONPATH=/home/ubuntu/guru_rag

[Install]
WantedBy=multi-user.target
